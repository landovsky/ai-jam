.bg-amber-50.min-h-screen.flex.items-center.justify-center.p-6
  .max-w-xl.w-full
    div class="bg-white border-4 border-stone-900 rounded-3xl p-8 md:p-12 shadow-[12px_12px_0px_0px_#1c1917]"
      .text-center.mb-8
        h1.text-3xl.md:text-4xl.font-black.mb-4.text-stone-900 = t('onboarding.step2.title')
        p.text-stone-600.font-bold = t('onboarding.step2.subtitle')

      = form_with model: @user, url: save_step2_onboarding_index_path, local: true, class: "space-y-6" do |f|
        - if @user.errors.any?
          .bg-red-50.border-2.border-red-900.text-red-900.p-4.rounded-xl.mb-6
            ul.list-disc.list-inside
              - @user.errors.full_messages.each do |msg|
                li = msg

        div
          = f.label :email, t('onboarding.step2.email_label'), class: "block text-sm font-black text-stone-900 uppercase tracking-wider mb-2"
          = f.email_field :email, class: "w-full bg-stone-50 border-2 border-stone-900 rounded-xl px-4 py-4 text-stone-900 font-bold focus:ring-0 focus:shadow-[4px_4px_0px_0px_#1c1917] focus:translate-x-[-2px] focus:translate-y-[-2px] outline-none transition-all", placeholder: t('onboarding.step2.email_placeholder')

        div
          = f.label :password, t('onboarding.step2.password_label'), class: "block text-sm font-black text-stone-900 uppercase tracking-wider mb-2"
          = f.password_field :password, class: "w-full bg-stone-50 border-2 border-stone-900 rounded-xl px-4 py-4 text-stone-900 font-bold focus:ring-0 focus:shadow-[4px_4px_0px_0px_#1c1917] focus:translate-x-[-2px] focus:translate-y-[-2px] outline-none transition-all"

        div
          = f.label :password_confirmation, t('onboarding.step2.password_confirmation_label'), class: "block text-sm font-black text-stone-900 uppercase tracking-wider mb-2"
          = f.password_field :password_confirmation, class: "w-full bg-stone-50 border-2 border-stone-900 rounded-xl px-4 py-4 text-stone-900 font-bold focus:ring-0 focus:shadow-[4px_4px_0px_0px_#1c1917] focus:translate-x-[-2px] focus:translate-y-[-2px] outline-none transition-all"

        = f.button t('onboarding.step2.submit'), class: "w-full bg-stone-900 hover:bg-stone-800 text-white font-black py-5 rounded-xl border-2 border-stone-900 shadow-[6px_6px_0px_0px_#a8a29e] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0px_0px_#a8a29e] transition-all text-xl uppercase tracking-widest cursor-pointer"
